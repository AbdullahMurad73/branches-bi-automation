// ============================================================
// مقاييس DAX — لوحة مبيعات الفروع
// ============================================================

// ---------- المقاييس الأساسية ----------

إجمالي المبيعات =
SUM ( 'المبيعات'[الإجمالي] )

عدد العمليات =
COUNTROWS ( 'المبيعات' )

إجمالي الكمية =
SUM ( 'المبيعات'[الكمية] )

متوسط قيمة العملية =
DIVIDE ( [إجمالي المبيعات], [عدد العمليات] )


// ---------- الذكاء الزمني ----------

مبيعات الشهر السابق =
CALCULATE (
    [إجمالي المبيعات],
    DATEADD ( 'التقويم'[التاريخ], -1, MONTH )
)

نمو شهري =
VAR الحالي  = [إجمالي المبيعات]
VAR السابق  = [مبيعات الشهر السابق]
RETURN
    DIVIDE ( الحالي - السابق, السابق )

مبيعات تراكمية للسنة =
CALCULATE (
    [إجمالي المبيعات],
    DATESYTD ( 'التقويم'[التاريخ] )
)


// ---------- تحليل الفروع ----------

عدد الفروع النشطة =
DISTINCTCOUNT ( 'المبيعات'[الفرع] )

متوسط مبيعات الفرع =
DIVIDE ( [إجمالي المبيعات], [عدد الفروع النشطة] )

ترتيب الفرع =
RANKX (
    ALL ( 'المبيعات'[الفرع] ),
    [إجمالي المبيعات],
    ,
    DESC,
    DENSE
)

// نسبة مساهمة الفرع من إجمالي الشبكة
نسبة مساهمة الفرع =
DIVIDE (
    [إجمالي المبيعات],
    CALCULATE ( [إجمالي المبيعات], ALL ( 'المبيعات'[الفرع] ) )
)

// أفضل فرع أداءً في السياق الحالي
أفضل فرع =
VAR الجدول =
    ADDCOLUMNS (
        VALUES ( 'المبيعات'[الفرع] ),
        "@مبيعات", [إجمالي المبيعات]
    )
RETURN
    MAXX ( TOPN ( 1, الجدول, [@مبيعات], DESC ), 'المبيعات'[الفرع] )


// ---------- مؤشرات الجودة ----------

صفوف تحتاج مراجعة =
CALCULATE (
    COUNTROWS ( 'المبيعات' ),
    'المبيعات'[تحقق_الإجمالي] = "يحتاج مراجعة"
)

نسبة سلامة البيانات =
DIVIDE (
    CALCULATE ( COUNTROWS ( 'المبيعات' ), 'المبيعات'[تحقق_الإجمالي] = "سليم" ),
    COUNTROWS ( 'المبيعات' )
)
